PORT=5000
MONGODB_URI=your_mongodb_connection_string_here
MONGO_URI=your_mongodb_connection_string_here
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_URL=http://localhost:5173

# Email verification. Use a real SMTP provider such as Gmail App Password, SendGrid SMTP, Mailgun SMTP, Brevo, etc.
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_DEBUG_LINKS=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM="KeyCove <your_email@gmail.com>"

# Optional for serverless demos. Vercel uses data-url fallback automatically because the filesystem is temporary.
UPLOAD_STORAGE_MODE=local
